---
import { t } from '../lib/i18n.js';

const { shop, lang } = Astro.props;
const tr = t(lang);

const parts = [shop.address, shop.subdistrict, shop.district, shop.province].filter(Boolean);
const addressText = parts.join(' ');

const lat = shop.coordinates?.latitude;
const lng = shop.coordinates?.longitude;
const mapsUrl =
  lat != null && lng != null
    ? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`
    : addressText
      ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressText)}`
      : null;

const show = addressText || mapsUrl;
---

{show && (
  <section class="border-t border-gray-100 px-5 py-5">
    <h2 class="mb-2 text-lg font-bold text-gray-900">{tr.location}</h2>
    {addressText && <p class="text-[15px] leading-relaxed text-gray-700">{addressText}</p>}
    {mapsUrl && (
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex items-center gap-1 rounded-lg border border-orange-200 px-4 py-2 text-sm font-medium text-orange-600"
      >
        📍 {tr.directions}
      </a>
    )}
  </section>
)}
