---
import { t } from '../lib/i18n.js';

const { items = [], lang, shopId } = Astro.props;
const tr = t(lang);

const fmt = (n) => `${tr.baht}${Number(n || 0).toLocaleString()}`;
const priceLabel = (item) => {
  const max = item.service?.priceMax;
  if (max && max > item.price) return `${fmt(item.price)} – ${fmt(max)}`;
  return fmt(item.price);
};
const isBook = lang === 'en';
---

{items.length > 0 && (
  <section class="border-t border-gray-100 px-5 py-5">
    <h2 class="mb-3 text-lg font-bold text-gray-900">{tr.services}</h2>
    <ul class="space-y-3">
      {items.map((item) => (
        <li class={`flex gap-3 ${item.isAvailable === false ? 'opacity-50' : ''}`}>
          {item.image && (
            <img
              src={item.image}
              alt={item.name}
              class="h-16 w-16 flex-none rounded-lg object-cover"
              loading="lazy"
            />
          )}
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-medium text-gray-900">{item.name}</span>
              <span class="flex-none font-semibold text-orange-600">{priceLabel(item)}</span>
            </div>
            {item.description && (
              <p class="mt-0.5 line-clamp-2 text-sm text-gray-500">{item.description}</p>
            )}
            <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-400">
              {item.service?.duration ? <span>⏱ {item.service.duration} {tr.minutes}</span> : null}
              {item.service?.requireBooking ? <span>📅 {tr.bookingRequired}</span> : null}
              {item.isAvailable !== false && shopId && (
                <button
                  class="book-btn ml-auto rounded-full bg-orange-500 px-3 py-1 text-xs font-semibold text-white hover:bg-orange-600 active:scale-95 transition-transform"
                  data-item-id={item._id}
                  data-item-name={item.name}
                  data-item-price={item.price}
                  data-item-duration={item.service?.duration || 60}
                  data-shop-id={shopId}
                  data-lang={lang}
                >
                  {isBook ? '📅 Book' : '📅 จองเลย'}
                </button>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

<!-- ── Booking Modal ─────────────────────────────────────── -->
{shopId && (
  <dialog id="booking-dialog" class="w-full max-w-sm rounded-2xl p-0 shadow-2xl backdrop:bg-black/50">
    <div class="p-5">
      <div class="mb-4 flex items-start justify-between">
        <div>
          <h3 class="text-base font-bold text-gray-900" id="bd-title">{isBook ? 'Book Service' : 'จองบริการ'}</h3>
          <p class="text-sm text-gray-500" id="bd-subtitle"></p>
        </div>
        <button id="bd-close" class="text-gray-400 hover:text-gray-600 text-xl leading-none">✕</button>
      </div>

      <!-- Step 1: Date -->
      <div id="bd-step1">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          {isBook ? 'Select date' : 'เลือกวันที่'}
        </label>
        <input
          type="date"
          id="bd-date"
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:border-orange-400 focus:outline-none"
        />
        <button id="bd-next1"
          class="mt-3 w-full rounded-xl bg-orange-500 py-2.5 text-sm font-semibold text-white hover:bg-orange-600 disabled:opacity-40"
          disabled>
          {isBook ? 'Next' : 'ถัดไป →'}
        </button>
      </div>

      <!-- Step 2: Time -->
      <div id="bd-step2" class="hidden">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-sm font-medium text-gray-700">{isBook ? 'Select time' : 'เลือกเวลา'}</span>
          <button id="bd-back2" class="text-xs text-orange-500">{isBook ? '← Back' : '← ย้อนกลับ'}</button>
        </div>
        <div id="bd-slots" class="grid grid-cols-4 gap-2 max-h-48 overflow-y-auto"></div>
        <p id="bd-slots-empty" class="hidden text-center text-sm text-gray-400 py-6">
          {isBook ? 'No available slots on this date' : 'ไม่มีเวลาว่างในวันนี้'}
        </p>
        <p id="bd-slots-loading" class="text-center text-sm text-gray-400 py-6">
          {isBook ? 'Loading...' : 'กำลังโหลด...'}
        </p>
      </div>

      <!-- Step 3: Info -->
      <div id="bd-step3" class="hidden">
        <div class="mb-3 flex items-center justify-between">
          <span class="text-sm font-medium text-gray-700">{isBook ? 'Your details' : 'ข้อมูลติดต่อ'}</span>
          <button id="bd-back3" class="text-xs text-orange-500">{isBook ? '← Back' : '← ย้อนกลับ'}</button>
        </div>
        <div id="bd-summary" class="mb-3 rounded-xl bg-orange-50 px-3 py-2 text-sm text-orange-800"></div>
        <input id="bd-name" type="text" placeholder={isBook ? 'Your name *' : 'ชื่อ-สกุล *'}
          class="mb-2 w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:border-orange-400 focus:outline-none" />
        <input id="bd-phone" type="tel" placeholder={isBook ? 'Phone number *' : 'เบอร์โทร *'}
          class="mb-2 w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:border-orange-400 focus:outline-none" />
        <input id="bd-notes" type="text" placeholder={isBook ? 'Notes (optional)' : 'หมายเหตุ (ถ้ามี)'}
          class="mb-3 w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:border-orange-400 focus:outline-none" />
        <p id="bd-err" class="hidden mb-2 text-xs text-red-500"></p>
        <button id="bd-submit"
          class="w-full rounded-xl bg-orange-500 py-2.5 text-sm font-semibold text-white hover:bg-orange-600 disabled:opacity-40">
          {isBook ? 'Confirm Booking' : 'ยืนยันการจอง'}
        </button>
      </div>

      <!-- Step 4: Success -->
      <div id="bd-step4" class="hidden text-center py-4">
        <div class="text-4xl mb-3">✅</div>
        <p class="font-bold text-gray-900 text-base">{isBook ? 'Booking Confirmed!' : 'จองสำเร็จ!'}</p>
        <p id="bd-confirm-num" class="mt-1 text-sm text-gray-500"></p>
        <p id="bd-confirm-detail" class="mt-1 text-sm text-orange-600 font-medium"></p>
        <p class="mt-3 text-xs text-gray-400">
          {isBook ? 'The shop will contact you to confirm.' : 'ร้านจะติดต่อกลับเพื่อยืนยัน'}
        </p>
        <button id="bd-done" class="mt-4 w-full rounded-xl bg-gray-100 py-2.5 text-sm font-semibold text-gray-700">
          {isBook ? 'Close' : 'ปิด'}
        </button>
      </div>
    </div>
  </dialog>
)}

<script>
(function () {
  const API = 'https://tripdedee.com/api';

  const dlg   = document.getElementById('booking-dialog');
  if (!dlg) return;

  const step1 = document.getElementById('bd-step1');
  const step2 = document.getElementById('bd-step2');
  const step3 = document.getElementById('bd-step3');
  const step4 = document.getElementById('bd-step4');

  let state = { shopId: '', itemId: '', itemName: '', itemPrice: 0, itemDuration: 60, lang: 'th', date: '', time: '' };

  const show = (el) => [step1, step2, step3, step4].forEach((s) => s.classList.toggle('hidden', s !== el));

  // Open modal from any "จองเลย" button
  document.querySelectorAll('.book-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.shopId       = btn.dataset.shopId;
      state.itemId       = btn.dataset.itemId;
      state.itemName     = btn.dataset.itemName;
      state.itemPrice    = Number(btn.dataset.itemPrice) || 0;
      state.itemDuration = Number(btn.dataset.itemDuration) || 60;
      state.lang         = btn.dataset.lang || 'th';

      document.getElementById('bd-title').textContent   = state.lang === 'en' ? 'Book Service' : 'จองบริการ';
      document.getElementById('bd-subtitle').textContent = state.itemName + (state.itemPrice ? ` · ฿${state.itemPrice.toLocaleString()}` : '');

      // Set date min = tomorrow (or today if minAdvanceHours=0)
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      const dateInput = document.getElementById('bd-date');
      dateInput.min   = tomorrow.toISOString().slice(0, 10);
      dateInput.value = '';
      document.getElementById('bd-next1').disabled = true;

      show(step1);
      dlg.showModal();
    });
  });

  // Close
  document.getElementById('bd-close').addEventListener('click', () => dlg.close());
  document.getElementById('bd-done').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  // Date input → enable Next
  document.getElementById('bd-date').addEventListener('change', (e) => {
    document.getElementById('bd-next1').disabled = !e.target.value;
  });

  // Step 1 → Step 2: fetch slots
  document.getElementById('bd-next1').addEventListener('click', async () => {
    state.date = document.getElementById('bd-date').value;
    show(step2);

    const slotsEl  = document.getElementById('bd-slots');
    const emptyEl  = document.getElementById('bd-slots-empty');
    const loadEl   = document.getElementById('bd-slots-loading');
    slotsEl.innerHTML = '';
    emptyEl.classList.add('hidden');
    loadEl.classList.remove('hidden');

    try {
      const url = `${API}/service/available-slots/${state.shopId}?date=${state.date}&serviceItemId=${state.itemId}`;
      const r   = await fetch(url);
      const j   = await r.json();
      loadEl.classList.add('hidden');

      if (j.data?.closedDay) {
        emptyEl.classList.remove('hidden');
        return;
      }

      const slots = j.data?.slots || [];
      const available = slots.filter((s) => s.available);
      if (!available.length) { emptyEl.classList.remove('hidden'); return; }

      available.forEach((slot) => {
        const btn = document.createElement('button');
        btn.textContent = slot.time;
        btn.className = 'rounded-xl border border-orange-400 py-2 text-sm font-medium text-orange-600 hover:bg-orange-500 hover:text-white transition-colors';
        btn.addEventListener('click', () => {
          state.time = slot.time;
          // Summary
          const thDate = new Date(state.date + 'T00:00:00').toLocaleDateString(state.lang === 'en' ? 'en-US' : 'th-TH', { day: 'numeric', month: 'short', year: 'numeric' });
          document.getElementById('bd-summary').textContent = `📅 ${thDate}  ⏰ ${slot.time}  ⏱ ${state.itemDuration} ${state.lang === 'en' ? 'min' : 'นาที'}`;
          document.getElementById('bd-name').value  = '';
          document.getElementById('bd-phone').value = '';
          document.getElementById('bd-notes').value = '';
          document.getElementById('bd-err').classList.add('hidden');
          show(step3);
        });
        slotsEl.appendChild(btn);
      });
    } catch {
      loadEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
    }
  });

  // Back buttons
  document.getElementById('bd-back2').addEventListener('click', () => show(step1));
  document.getElementById('bd-back3').addEventListener('click', () => show(step2));

  // Submit
  document.getElementById('bd-submit').addEventListener('click', async () => {
    const name  = document.getElementById('bd-name').value.trim();
    const phone = document.getElementById('bd-phone').value.replace(/[-\s]/g, '').trim();
    const notes = document.getElementById('bd-notes').value.trim();
    const errEl = document.getElementById('bd-err');
    const isEn  = state.lang === 'en';

    if (!name) { errEl.textContent = isEn ? 'Please enter your name' : 'กรุณากรอกชื่อ'; errEl.classList.remove('hidden'); return; }
    if (!/^\d{9,10}$/.test(phone)) { errEl.textContent = isEn ? 'Invalid phone number' : 'กรุณากรอกเบอร์โทร 9-10 หลัก'; errEl.classList.remove('hidden'); return; }
    errEl.classList.add('hidden');

    const submitBtn = document.getElementById('bd-submit');
    submitBtn.disabled = true;
    submitBtn.textContent = isEn ? 'Sending...' : 'กำลังส่ง...';

    try {
      const res = await fetch(`${API}/service/guest-booking`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          shopId: state.shopId,
          serviceItemId: state.itemId,
          bookingDate: state.date,
          bookingTime: state.time,
          customerName: name,
          customerPhone: phone,
          notes,
        }),
      });
      const j = await res.json();
      if (!j.success) {
        errEl.textContent = j.message || (isEn ? 'Booking failed. Please try again.' : 'เกิดข้อผิดพลาด กรุณาลองใหม่');
        errEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = isEn ? 'Confirm Booking' : 'ยืนยันการจอง';
        return;
      }
      const d = j.data;
      const thDate = new Date(d.bookingDate + 'T00:00:00').toLocaleDateString(isEn ? 'en-US' : 'th-TH', { day: 'numeric', month: 'short', year: 'numeric' });
      document.getElementById('bd-confirm-num').textContent  = `#${d.orderNumber}`;
      document.getElementById('bd-confirm-detail').textContent = `${d.shopName} · ${thDate} ${d.bookingTime}`;
      show(step4);
    } catch {
      errEl.textContent = isEn ? 'Network error. Please try again.' : 'เกิดข้อผิดพลาด กรุณาลองใหม่';
      errEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = isEn ? 'Confirm Booking' : 'ยืนยันการจอง';
    }
  });
})();
</script>
