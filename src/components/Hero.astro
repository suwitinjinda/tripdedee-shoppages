---
import { t } from '../lib/i18n.js';

const { shop, lang, name, typeLabel } = Astro.props;
const tr = t(lang);
const hero = Array.isArray(shop.images) && shop.images.length ? shop.images[0] : null;
const rating = shop.averageRating ? Number(shop.averageRating).toFixed(1) : null;

const badges = [];
if (shop.isEarlyBird) badges.push(tr.earlyBird);
if (shop.deliveryOption === 'accept_delivery' || shop.deliveryOption === 'both') badges.push(tr.delivery);
if (shop.shopMode === 'offline' || shop.shopMode === 'both') badges.push(tr.dineIn);
if (shop.shopMode === 'online') badges.push(tr.online);
---

<header>
  {hero ? (
    <div class="aspect-[16/10] w-full overflow-hidden bg-gray-100">
      <img src={hero} alt={name} class="h-full w-full object-cover" loading="eager" />
    </div>
  ) : (
    <div class="aspect-[16/10] w-full bg-orange-500"></div>
  )}

  <div class="px-5 pt-5 pb-2">
    <p class="text-sm font-medium text-orange-600">{typeLabel}</p>
    <h1 class="mt-1 text-2xl font-bold leading-tight text-gray-900">{name}</h1>

    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-600">
      {rating && (
        <span class="font-medium text-gray-900">
          ★ {rating}
          {shop.totalReviews ? <span class="font-normal text-gray-500"> ({shop.totalReviews} {tr.reviews})</span> : null}
        </span>
      )}
      {(shop.district || shop.province) && (
        <span>{[shop.district, shop.province].filter(Boolean).join(', ')}</span>
      )}
    </div>

    {badges.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {badges.map((b) => (
          <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-medium text-orange-700">{b}</span>
        ))}
      </div>
    )}
  </div>
</header>
