---
// Search bar used on the directory homepage + repeated at the top of each
// results page. Posts as plain GET to /shop/search so it works without JS.
const { q = '', province = '', shopType = '', size = 'default' } = Astro.props;
const isHero = size === 'hero';
---

<form
  action="/shop/search"
  method="get"
  class={isHero
    ? 'flex flex-col gap-2 rounded-2xl bg-white p-3 shadow-lg sm:flex-row sm:items-center'
    : 'flex flex-col gap-2 rounded-xl bg-white p-2 shadow-sm border border-gray-200 sm:flex-row sm:items-center'}
>
  <div class={isHero ? 'flex flex-1 items-center gap-2 px-3' : 'flex flex-1 items-center gap-2 px-2'}>
    <svg class={isHero ? 'h-5 w-5 text-orange-500' : 'h-4 w-4 text-gray-400'} fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      name="q"
      type="text"
      value={q}
      placeholder="ค้นหาชื่อร้าน อาหาร หรือบริการ..."
      class={isHero
        ? 'flex-1 border-0 bg-transparent text-base text-gray-900 placeholder-gray-400 outline-none'
        : 'flex-1 border-0 bg-transparent text-sm text-gray-900 placeholder-gray-400 outline-none'}
      autocomplete="off"
    />
  </div>
  {province ? <input type="hidden" name="province" value={province} /> : null}
  {shopType ? <input type="hidden" name="shopType" value={shopType} /> : null}
  <button
    type="submit"
    class={isHero
      ? 'rounded-xl bg-orange-500 px-6 py-3 text-base font-bold text-white shadow-sm transition hover:bg-orange-600'
      : 'rounded-lg bg-orange-500 px-4 py-2 text-sm font-bold text-white transition hover:bg-orange-600'}
  >
    ค้นหา
  </button>
</form>
