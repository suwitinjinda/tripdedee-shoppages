---
import { t } from '../lib/i18n.js';

const { items = [], lang } = Astro.props;
const tr = t(lang);

const fmt = (n) => `${tr.baht}${Number(n || 0).toLocaleString()}`;
---

{items.length > 0 && (
  <section class="border-t border-gray-100 px-5 py-5">
    <h2 class="mb-3 text-lg font-bold text-gray-900">{tr.products}</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {items.map((item) => (
        <div class={`overflow-hidden rounded-xl border border-gray-100 ${item.isAvailable === false ? 'opacity-50' : ''}`}>
          <div class="aspect-square bg-gray-100">
            {item.image && (
              <img src={item.image} alt={item.name} class="h-full w-full object-cover" loading="lazy" />
            )}
          </div>
          <div class="p-2.5">
            <p class="line-clamp-2 text-sm font-medium text-gray-900">{item.name}</p>
            <p class="mt-1 font-semibold text-orange-600">
              {fmt(item.price)}
              {item.unit ? <span class="text-xs font-normal text-gray-400"> / {item.unit}</span> : null}
            </p>
            {item.isAvailable === false && (
              <span class="text-xs text-gray-400">{tr.unavailable}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
