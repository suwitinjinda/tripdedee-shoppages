---
// หน้า "ร้าน<เมนู>" ทั้งประเทศ และ "ร้าน<เมนู>ใน<จังหวัด>" (27 ต.ค. 2569)
//
// เจ้าของ: คนถาม ChatGPT/Google ว่า "ข้าวต้ม ใกล้ฉัน" / "ร้านอาหารเหนือ เชียงใหม่" ต้องเจอร้านจริง
// ทุกอย่างบนหน้ามาจากหลังบ้าน (services/publicFoodDishes.js) — ชื่อเมนูกับราคาเป็นของร้านจริง
// ไม่มีเรตติ้งแต่ง ไม่มีตัวเลขเดา · หน้าที่ร้านไม่ถึงเกณฑ์ไม่ถึงตรงนี้ (route ตอบ 404 ไปแล้ว)
import DirectoryLayout from '../layouts/DirectoryLayout.astro';
import { shopHref } from '../lib/slug.js';
import { typeLabel } from '../lib/shopType.js';
import { foodHref, dishLabel } from '../lib/food.js';

const { page, all, lang = 'th' } = Astro.props;
const en = lang === 'en';
const SITE = 'https://tripdedee.com';
const dish = page.dish;
const label = dishLabel(dish, lang);
const province = page.province || '';
const total = Number(page.total) || 0;
const shops = page.shops || [];
const otherLang = en ? 'th' : 'en';
const canonical = SITE + foodHref(lang, dish.slug, province);
const alternateUrl = SITE + foodHref(otherLang, dish.slug, province);
const nf = (n) => Number(n || 0).toLocaleString(en ? 'en-US' : 'th-TH');
const baht = (n) => '฿' + Number(n || 0).toLocaleString('en-US');

// จังหวัดอื่นที่มีเมนูนี้ (ถึงเกณฑ์) · เมนูอื่นในจังหวัดนี้ (ถึงเกณฑ์)
const dishRow = (all.dishes || []).find((d) => d.slug === dish.slug);
const provinces = province ? (dishRow?.provinces || []) : (page.provinces || []);
const otherDishesHere = province
  ? (all.dishes || [])
      .filter((d) => d.slug !== dish.slug)
      .map((d) => ({ d, hit: (d.provinces || []).find((p) => p.province === province) }))
      .filter((x) => x.hit)
      .sort((a, b) => b.hit.count - a.hit.count)
  : [];
const nProvinces = province ? 0 : provinces.length;

const heading = province
  ? (en ? `${label} in ${province}` : `ร้าน${label} ${province}`)
  : (en ? `${label} — shops across Thailand` : `ร้าน${label} ทั่วไทย`);
const title = province
  /* 8 พ.ย. 2569 · Search Console: "ร้านอาหารอีสานใกล้ฉัน" เห็น 81 ครั้ง กด 1 · ชื่อเดิมไม่มีคำว่าใกล้ จึงไม่ตรงกับที่คนค้น */
  ? (en ? `${label} near you in ${province} · ${nf(total)} shops with menus & prices | TripDeDee`
        : `ร้าน${label}ใกล้ฉัน ใน${province} · ${nf(total)} ร้าน ดูเมนู ราคา สั่งได้ | TripDeDee`)
  : (en ? `${label} · ${nf(total)} shops in Thailand with menus & prices | TripDeDee`
        : `ร้าน${label} · ${nf(total)} ร้านทั่วไทย พร้อมเมนูและราคา | TripDeDee`);
const sampleNames = shops.slice(0, 3).map((s) => (en ? s.nameEn || s.shopName : s.shopName)).filter(Boolean);
const description = province
  ? (en
      ? `Find ${label} near you in ${province}: ${nf(total)} shops on TripDeDee${sampleNames.length ? `, including ${sampleNames.join(', ')}` : ''}. Sort by distance from you, see menu items and prices, then order.`
      : `หาร้าน${label}ใกล้คุณใน${province} ${nf(total)} ร้านบน TripDeDee${sampleNames.length ? ` เช่น ${sampleNames.join(', ')}` : ''} — กดเรียงร้านใกล้ฉัน ดูชื่อเมนู ราคาจากร้าน แล้วสั่งได้เลย`)
  : (en
      ? `${nf(total)} shops on TripDeDee with ${label} on their menu${nProvinces ? ` in ${nf(nProvinces)} provinces` : ''}. Pick a province to see shops, menu items and prices.`
      : `รวม ${nf(total)} ร้านที่มีเมนู${label}บน TripDeDee${nProvinces ? ` ใน ${nf(nProvinces)} จังหวัด` : ''} — เลือกจังหวัดเพื่อดูร้าน ชื่อเมนู และราคา`);

const crumbs = [
  { name: en ? 'All shops' : 'ทุกร้าน', url: SITE + (en ? '/shop/' : '/shop/') },
  { name: en ? 'Food' : 'เมนูอาหาร', url: SITE + (en ? '/shop/en/food' : '/shop/food') },
  { name: label, url: SITE + foodHref(lang, dish.slug) },
  ...(province ? [{ name: province, url: canonical }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical + '#page',
      name: heading,
      url: canonical,
      inLanguage: en ? 'en' : 'th',
      description,
      about: province
        ? { '@type': 'Place', name: province, address: { '@type': 'PostalAddress', addressRegion: province, addressCountry: 'TH' } }
        : undefined,
      mainEntity: { '@id': canonical + '#shops' },
      breadcrumb: { '@id': canonical + '#breadcrumb' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': canonical + '#breadcrumb',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
    },
    {
      '@type': 'ItemList',
      '@id': canonical + '#shops',
      name: heading,
      numberOfItems: total,
      itemListElement: shops.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: SITE + shopHref(lang, s),
        name: en ? s.nameEn || s.shopName : s.shopName,
      })),
    },
  ],
};
---

<DirectoryLayout
  lang={lang}
  title={title}
  description={description}
  canonical={canonical}
  alternateUrl={alternateUrl}
  alternateLang={otherLang}
  jsonLd={jsonLd}
>
  <nav class="mb-3 text-xs text-gray-500" aria-label={en ? 'Breadcrumb' : 'เส้นทาง'}>
    <a href="/shop/" class="hover:text-orange-600">{crumbs[0].name}</a> ›
    <a href={en ? '/shop/en/food' : '/shop/food'} class="hover:text-orange-600">{crumbs[1].name}</a> ›
    {province ? (
      <>
        <a href={foodHref(lang, dish.slug)} class="hover:text-orange-600">{label}</a> ›
        <span class="text-gray-700">{province}</span>
      </>
    ) : (
      <span class="text-gray-700">{label}</span>
    )}
  </nav>

  <div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h1 class="text-2xl font-extrabold text-gray-900">{heading}</h1>
    <span class="text-sm text-gray-500">{nf(total)} {en ? 'shops' : 'ร้าน'}</span>
  </div>
  <p class="mb-5 text-sm leading-relaxed text-gray-600">{description}</p>

  {province && shops.some((s) => s.lat != null) && (
    /* เรียงร้านใกล้ฉัน (8 พ.ย. 2569) · ขอตำแหน่งตอนกดเท่านั้น · วัดระยะบนเครื่อง ไม่ส่งตำแหน่งไปไหน · ร้านไม่มีพิกัดไปอยู่ท้าย */
    <div id="nearbar" class="mb-5 flex flex-wrap items-center gap-3 rounded-2xl bg-gradient-to-r from-orange-500 to-[#e2641c] p-4 text-white shadow-md">
      <div class="min-w-0 flex-1">
        <p class="text-base font-extrabold leading-snug">{en ? `📍 ${label} near you` : `📍 ร้าน${label}ใกล้ฉัน`}</p>
        <p id="nearmsg" class="mt-0.5 text-xs text-white/90">{en ? 'Sort these shops by distance from where you are' : 'เรียงร้านในหน้านี้ตามระยะจากตัวคุณ'}</p>
      </div>
      <button id="nearbtn" type="button" class="shrink-0 rounded-xl bg-white px-4 py-2.5 text-sm font-extrabold text-[#c2410c] shadow">
        {en ? 'Sort near me' : 'เรียงใกล้ฉัน'}
      </button>
    </div>
  )}

  {!province && provinces.length > 0 && (
    <section class="mb-6" aria-label={en ? 'By province' : 'เลือกจังหวัด'}>
      <h2 class="mb-2 text-base font-bold text-gray-900">{en ? `${label} by province` : `ร้าน${label}แยกตามจังหวัด`}</h2>
      <ul class="flex flex-wrap gap-2">
        {provinces.map((p) => (
          <li>
            <a href={foodHref(lang, dish.slug, p.province)} class="inline-block rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 hover:border-orange-300 hover:text-orange-700">
              {p.province} <span class="text-gray-400">({nf(p.count)})</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {!province && (
    <h2 class="mb-3 text-base font-bold text-gray-900">{en ? `Shops with ${label}` : `ร้านที่มีเมนู${label}`}</h2>
  )}

  <ol id="shoplist" class="grid gap-3 sm:grid-cols-2">
    {shops.map((s) => {
      const name = en ? s.nameEn || s.shopName : s.shopName;
      const area = [s.district, s.province].filter(Boolean).join(', ');
      return (
        <li class="shoprow rounded-2xl border border-gray-200 bg-white p-3 shadow-sm" data-lat={s.lat ?? ''} data-lng={s.lng ?? ''}>
          <div class="flex gap-3">
            {s.image ? (
              <img src={s.image} alt={name} loading="lazy" class="h-16 w-16 shrink-0 rounded-xl bg-gray-100 object-cover" />
            ) : (
              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-gray-100 text-2xl text-gray-300">🍽</div>
            )}
            <div class="min-w-0 flex-1">
              <h3 class="text-[15px] font-bold leading-snug text-gray-900">
                <a href={shopHref(lang, s)} class="hover:text-orange-600">{name}</a>
              </h3>
              <p class="mt-0.5 text-xs text-gray-500">
                {typeLabel(s, lang)}{area ? ` · ${area}` : ''}
              </p>
              <p class="dist mt-1 hidden text-xs font-bold text-orange-600"></p>
            </div>
          </div>

          {s.items && s.items.length > 0 ? (
            <ul class="mt-2 divide-y divide-gray-100 text-sm" aria-label={en ? `${label} menu items` : `เมนู${label}ของร้าน`}>
              {s.items.map((it) => (
                <li class="flex items-baseline justify-between gap-3 py-1.5">
                  <span class="min-w-0 text-gray-800">{en ? it.nameEn || it.name : it.name}</span>
                  <span class="shrink-0 font-bold text-orange-600">{baht(it.price)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-xs text-gray-500">{en ? `Shop name mentions ${label}` : `ชื่อร้านมีคำว่า${label}`}</p>
          )}
          {s.matchedCount > (s.items || []).length && (
            <p class="mt-1 text-xs text-gray-400">
              {en ? `+${nf(s.matchedCount - s.items.length)} more on the menu` : `และอีก ${nf(s.matchedCount - s.items.length)} รายการในเมนูร้าน`}
            </p>
          )}

          <div class="mt-3 flex gap-2">
            <a href={shopHref(lang, s)} class="flex-1 rounded-xl border border-gray-200 px-3 py-2 text-center text-sm font-semibold text-gray-700 hover:border-orange-300">
              {en ? 'Shop page' : 'ดูหน้าร้าน'}
            </a>
            {s.shortCode && (
              <a href={`https://tripdedee.com/f/${encodeURIComponent(s.shortCode)}`} class="flex-1 rounded-xl bg-[#e2641c] px-3 py-2 text-center text-sm font-bold text-white">
                {en ? 'See menu & order' : 'ดูเมนู · สั่งเลย'}
              </a>
            )}
          </div>
        </li>
      );
    })}
  </ol>

  {total > shops.length && (
    <p class="mt-4 text-center text-sm text-gray-500">
      {en ? `Showing ${nf(shops.length)} of ${nf(total)} shops` : `แสดง ${nf(shops.length)} จาก ${nf(total)} ร้าน`}
    </p>
  )}

  {province && provinces.length > 1 && (
    <section class="mt-8">
      <h2 class="mb-2 text-base font-bold text-gray-900">{en ? `${label} in other provinces` : `ร้าน${label}จังหวัดอื่น`}</h2>
      <ul class="flex flex-wrap gap-2">
        {provinces.filter((p) => p.province !== province).map((p) => (
          <li>
            <a href={foodHref(lang, dish.slug, p.province)} class="inline-block rounded-full border border-gray-200 bg-white px-3 py-1 text-sm text-gray-700 hover:border-orange-300">
              {p.province} <span class="text-gray-400">({nf(p.count)})</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {otherDishesHere.length > 0 && (
    <section class="mt-6">
      <h2 class="mb-2 text-base font-bold text-gray-900">{en ? `More food in ${province}` : `เมนูอื่นใน${province}`}</h2>
      <ul class="flex flex-wrap gap-2">
        {otherDishesHere.map(({ d, hit }) => (
          <li>
            <a href={foodHref(lang, d.slug, province)} class="inline-block rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-sm text-orange-700 hover:border-orange-400">
              {dishLabel(d, lang)} <span class="text-orange-400">({nf(hit.count)})</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm">
        <a href={`/shop/area/${encodeURIComponent(province)}`} class="text-orange-600 underline">
          {en ? `All shops in ${province}` : `ร้านทั้งหมดในจังหวัด${province}`}
        </a>
      </p>
    </section>
  )}

  {province && (
    /* ร้านใกล้ที่เที่ยว (8 พ.ย. 2569 · tripdedee.com/f/t?province=…) */
    <a href={`https://tripdedee.com/f/t?province=${encodeURIComponent(province)}&src=food-${encodeURIComponent(dish.slug)}`} class="mt-8 flex items-center gap-3 rounded-2xl border border-blue-200 bg-blue-50 p-4 hover:border-blue-400">
      <span class="text-2xl">🗺</span>
      <span class="min-w-0 flex-1">
        <span class="block text-[15px] font-bold text-gray-900">{en ? `Visiting ${province}? Food near the sights` : `เที่ยว${province}? ดูร้านอร่อยรอบที่เที่ยว`}</span>
        <span class="block text-xs text-gray-600">{en ? 'Pick a place and see shops on TripDeDee around it' : 'เลือกที่เที่ยว แล้วดูร้านในแอปรอบ ๆ ที่นั่น'}</span>
      </span>
      <span class="text-blue-600">→</span>
    </a>
  )}

  <p class="mt-8 text-center text-sm">
    <a href={alternateUrl.replace(SITE, '')} class="text-gray-500 underline">{en ? 'ภาษาไทย' : 'English'}</a>
  </p>
  <script is:inline define:vars={{ en }}>
    (function () {
      var btn = document.getElementById('nearbtn'); var msg = document.getElementById('nearmsg'); var list = document.getElementById('shoplist');
      if (!btn || !list) return;
      function km(a, b, c, d) { var t = Math.PI / 180, x = Math.pow(Math.sin((c - a) * t / 2), 2) + Math.cos(a * t) * Math.cos(c * t) * Math.pow(Math.sin((d - b) * t / 2), 2); return 12742 * Math.asin(Math.sqrt(x)); }
      btn.addEventListener('click', function () {
        if (!navigator.geolocation) { msg.textContent = en ? 'This device cannot share location' : 'เครื่องนี้ระบุตำแหน่งไม่ได้'; return; }
        btn.disabled = true; msg.textContent = en ? 'Finding your location…' : 'กำลังหาตำแหน่ง…';
        navigator.geolocation.getCurrentPosition(function (p) {
          var la = p.coords.latitude, lo = p.coords.longitude;
          var rows = Array.prototype.slice.call(list.querySelectorAll('.shoprow'));
          rows.forEach(function (r) { var a = parseFloat(r.dataset.lat), b = parseFloat(r.dataset.lng); r._d = isFinite(a) && isFinite(b) ? km(la, lo, a, b) : Infinity;
            var d = r.querySelector('.dist'); if (d && isFinite(r._d)) { d.textContent = (en ? '📍 ' + r._d.toFixed(1) + ' km from you' : '📍 ห่างจากคุณ ' + r._d.toFixed(1) + ' กม.'); d.classList.remove('hidden'); } });
          rows.sort(function (x, y) { return x._d - y._d; }).forEach(function (r) { list.appendChild(r); });
          var n = rows.filter(function (r) { return isFinite(r._d); });
          msg.textContent = n.length ? (en ? 'Sorted · nearest ' + n[0]._d.toFixed(1) + ' km' : 'เรียงแล้ว · ใกล้สุด ' + n[0]._d.toFixed(1) + ' กม.') : (en ? 'No shop locations to compare' : 'ร้านในหน้านี้ไม่มีพิกัด');
          btn.disabled = false; btn.textContent = en ? 'Re-sort' : 'เรียงใหม่';
          list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, function () { btn.disabled = false; msg.textContent = en ? 'Allow location to sort by distance' : 'ต้องอนุญาตให้ใช้ตำแหน่งก่อน ถึงจะเรียงตามระยะได้'; },
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
      });
    })();
  </script>
</DirectoryLayout>
