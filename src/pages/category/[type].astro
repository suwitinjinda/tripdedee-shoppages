---
// SSR category listing — /shop/category/<shopType>
// Mirror of /shop/area/<province>, filters by shopType instead.
import DirectoryLayout from '../../layouts/DirectoryLayout.astro';
import ShopCard from '../../components/ShopCard.astro';
import { searchShops, getShopFacets } from '../../lib/api.js';
import { typeLabel } from '../../lib/shopType.js';

const shopTypeRaw = decodeURIComponent(Astro.params.type || '').slice(0, 50).trim();
if (!shopTypeRaw) {
  Astro.response.status = 404;
}

const offset = Math.max(0, parseInt(Astro.url.searchParams.get('offset') || '0', 10) || 0);
const province = String(Astro.url.searchParams.get('province') || '').slice(0, 50).trim();
const limit = 24;

const [results, facets] = await Promise.all([
  searchShops({ shopType: shopTypeRaw, province, limit, offset }),
  getShopFacets(),
]);

if (results.total === 0 && offset === 0 && !province) {
  Astro.response.status = 404;
}

const typeText = typeLabel({ shopType: shopTypeRaw }, 'th');
const heading = province
  ? `${typeText} ใน ${province}`
  : `${typeText}ทั้งหมด`;
const title = `${heading} | TripDeDee`;
// ไม่ใส่จำนวนร้าน (27 ต.ค. 2569) · ยอดจาก /shop/search กับ /shop/facets รวมหมุดที่นำเข้าจาก
// แผนที่สาธารณะ (importSource) ด้วย ตอนตรวจภูเก็ต 484 ร้าน เป็นหมุดนำเข้า 427 · ทั้งประเทศ 5,466 จาก 8,283
// หลังบ้านไม่มียอดร้านจริงแยกให้ จึงเอาตัวเลขออกแทนการเดา · AI จะได้ไม่อ้างตัวเลขที่เป่าเกินจริง
const description = `${typeText}${province ? ' ในจังหวัด' + province : 'ทั่วประเทศ'} — เมนู ราคา ที่ตั้ง รีวิว`;
const canonical = `https://tripdedee.com/shop/category/${encodeURIComponent(shopTypeRaw)}${province ? '?province=' + encodeURIComponent(province) : ''}`;

const nextOffset = offset + limit;
const prevOffset = Math.max(0, offset - limit);
const hasNext = nextOffset < results.total;
const hasPrev = offset > 0;
const pageQs = (off) => {
  const u = new URLSearchParams();
  if (province) u.set('province', province);
  if (off > 0) u.set('offset', String(off));
  return u.toString();
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heading,
  url: canonical,
};
---

<DirectoryLayout
  lang="th"
  title={title}
  description={description}
  canonical={canonical}
  searchType={shopTypeRaw}
  searchProvince={province}
  noindex={offset > 0}
  jsonLd={jsonLd}
>
  <nav class="mb-3 text-xs text-gray-500">
    <a href="/shop/" class="hover:text-orange-600">ทุกร้าน</a> ›
    <span class="text-gray-700">{typeText}</span>
  </nav>

  <div class="mb-6 flex flex-wrap items-baseline gap-3">
    <h1 class="text-2xl font-extrabold text-gray-900">{heading}</h1>
  </div>

  {/* Province filter within this category */}
  {facets.provinces.length > 0 && (
    <div class="mb-6 -mx-1 flex gap-2 overflow-x-auto pb-2">
      <a
        href={`/shop/category/${encodeURIComponent(shopTypeRaw)}`}
        class={`shrink-0 rounded-full border px-3 py-1 text-xs font-medium ${!province ? 'border-orange-500 bg-orange-50 text-orange-700' : 'border-gray-200 bg-white text-gray-600 hover:border-orange-300'}`}
      >
        ทุกจังหวัด
      </a>
      {facets.provinces.slice(0, 15).map((p) => {
        const u = new URLSearchParams();
        u.set('province', p.province);
        return (
          <a
            href={`/shop/category/${encodeURIComponent(shopTypeRaw)}?${u.toString()}`}
            class={`shrink-0 rounded-full border px-3 py-1 text-xs font-medium ${province === p.province ? 'border-orange-500 bg-orange-50 text-orange-700' : 'border-gray-200 bg-white text-gray-600 hover:border-orange-300'}`}
          >
            {p.province}
          </a>
        );
      })}
    </div>
  )}

  {results.shops.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-16 text-center">
      <div class="text-5xl">🏬</div>
      <p class="mt-3 text-base font-bold text-gray-700">ยังไม่มี{typeText}ในกรองนี้</p>
      <a href="/shop/" class="mt-4 inline-block rounded-lg bg-orange-500 px-5 py-2 text-sm font-bold text-white hover:bg-orange-600">
        ดูร้านทั้งหมด
      </a>
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {results.shops.map((shop) => <ShopCard shop={shop} lang="th" />)}
    </div>
  )}

  {(hasNext || hasPrev) && (
    <div class="mt-8 flex items-center justify-center gap-3">
      {hasPrev ? (
        <a href={`/shop/category/${encodeURIComponent(shopTypeRaw)}?${pageQs(prevOffset)}`} class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-bold text-gray-700 hover:border-orange-300 hover:text-orange-700" rel="prev">
          ← ก่อนหน้า
        </a>
      ) : <span></span>}
      <span class="text-sm text-gray-500">
        {offset + 1}–{Math.min(offset + limit, results.total)} จาก {results.total.toLocaleString()}
      </span>
      {hasNext ? (
        <a href={`/shop/category/${encodeURIComponent(shopTypeRaw)}?${pageQs(nextOffset)}`} class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-bold text-gray-700 hover:border-orange-300 hover:text-orange-700" rel="next">
          ถัดไป →
        </a>
      ) : <span></span>}
    </div>
  )}
</DirectoryLayout>
