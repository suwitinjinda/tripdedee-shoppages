---
// SSR province listing — /shop/area/<province>
// Same shape as the search page but pre-filters by province. Helps SEO
// because each province gets its own indexable URL with a dedicated title.
import DirectoryLayout from '../../layouts/DirectoryLayout.astro';
import ShopCard from '../../components/ShopCard.astro';
import { searchShops, getShopFacets } from '../../lib/api.js';
import { typeLabel } from '../../lib/shopType.js';

const provinceRaw = decodeURIComponent(Astro.params.province || '').slice(0, 50).trim();
if (!provinceRaw) {
  Astro.response.status = 404;
}

const offset = Math.max(0, parseInt(Astro.url.searchParams.get('offset') || '0', 10) || 0);
const shopType = String(Astro.url.searchParams.get('shopType') || '').slice(0, 50).trim();
const limit = 24;

const [results, facets] = await Promise.all([
  searchShops({ province: provinceRaw, shopType, limit, offset }),
  getShopFacets(),
]);

if (results.total === 0 && offset === 0) {
  Astro.response.status = 404;
}

const heading = shopType
  ? `${typeLabel({ shopType }, 'th')} ใน ${provinceRaw}`
  : `ร้านในจังหวัด${provinceRaw}`;
const title = `${heading} | TripDeDee`;
// ไม่ใส่จำนวนร้าน (27 ต.ค. 2569) · ยอดจาก /shop/search กับ /shop/facets รวมหมุดที่นำเข้าจาก
// แผนที่สาธารณะ (importSource) ด้วย ตอนตรวจภูเก็ต 484 ร้าน เป็นหมุดนำเข้า 427 · ทั้งประเทศ 5,466 จาก 8,283
// หลังบ้านไม่มียอดร้านจริงแยกให้ จึงเอาตัวเลขออกแทนการเดา · AI จะได้ไม่อ้างตัวเลขที่เป่าเกินจริง
const description = `${shopType ? typeLabel({ shopType }, 'th') : 'ร้าน'}ในจังหวัด${provinceRaw} — เมนู ราคา ที่ตั้ง รีวิว`;
const canonical = `https://tripdedee.com/shop/area/${encodeURIComponent(provinceRaw)}${shopType ? '?shopType=' + encodeURIComponent(shopType) : ''}`;

const nextOffset = offset + limit;
const prevOffset = Math.max(0, offset - limit);
const hasNext = nextOffset < results.total;
const hasPrev = offset > 0;
const pageQs = (off) => {
  const u = new URLSearchParams();
  if (shopType) u.set('shopType', shopType);
  if (off > 0) u.set('offset', String(off));
  return u.toString();
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heading,
  url: canonical,
  about: {
    '@type': 'Place',
    name: provinceRaw,
    addressRegion: provinceRaw,
    addressCountry: 'TH',
  },
};
---

<DirectoryLayout
  lang="th"
  title={title}
  description={description}
  canonical={canonical}
  searchProvince={provinceRaw}
  searchType={shopType}
  noindex={offset > 0}
  jsonLd={jsonLd}
>
  <nav class="mb-3 text-xs text-gray-500">
    <a href="/shop/" class="hover:text-orange-600">ทุกร้าน</a> ›
    <span class="text-gray-700">{provinceRaw}</span>
  </nav>

  <div class="mb-6 flex flex-wrap items-baseline gap-3">
    <h1 class="text-2xl font-extrabold text-gray-900">{heading}</h1>
  </div>

  {/* shopType filter within this province */}
  {facets.shopTypes.length > 0 && (
    <div class="mb-6 -mx-1 flex gap-2 overflow-x-auto pb-2">
      <a
        href={`/shop/area/${encodeURIComponent(provinceRaw)}`}
        class={`shrink-0 rounded-full border px-3 py-1 text-xs font-medium ${!shopType ? 'border-orange-500 bg-orange-50 text-orange-700' : 'border-gray-200 bg-white text-gray-600 hover:border-orange-300'}`}
      >
        ทั้งหมด
      </a>
      {facets.shopTypes.slice(0, 10).map((t) => {
        const u = new URLSearchParams();
        u.set('shopType', t.shopType);
        return (
          <a
            href={`/shop/area/${encodeURIComponent(provinceRaw)}?${u.toString()}`}
            class={`shrink-0 rounded-full border px-3 py-1 text-xs font-medium ${shopType === t.shopType ? 'border-orange-500 bg-orange-50 text-orange-700' : 'border-gray-200 bg-white text-gray-600 hover:border-orange-300'}`}
          >
            {typeLabel({ shopType: t.shopType }, 'th')}
          </a>
        );
      })}
    </div>
  )}

  {results.shops.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-16 text-center">
      <div class="text-5xl">📍</div>
      <p class="mt-3 text-base font-bold text-gray-700">ยังไม่มีร้านในจังหวัดนี้</p>
      <a href="/shop/" class="mt-4 inline-block rounded-lg bg-orange-500 px-5 py-2 text-sm font-bold text-white hover:bg-orange-600">
        ดูร้านทั้งหมด
      </a>
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {results.shops.map((shop) => <ShopCard shop={shop} lang="th" />)}
    </div>
  )}

  {(hasNext || hasPrev) && (
    <div class="mt-8 flex items-center justify-center gap-3">
      {hasPrev ? (
        <a href={`/shop/area/${encodeURIComponent(provinceRaw)}?${pageQs(prevOffset)}`} class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-bold text-gray-700 hover:border-orange-300 hover:text-orange-700" rel="prev">
          ← ก่อนหน้า
        </a>
      ) : <span></span>}
      <span class="text-sm text-gray-500">
        {offset + 1}–{Math.min(offset + limit, results.total)} จาก {results.total.toLocaleString()}
      </span>
      {hasNext ? (
        <a href={`/shop/area/${encodeURIComponent(provinceRaw)}?${pageQs(nextOffset)}`} class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-bold text-gray-700 hover:border-orange-300 hover:text-orange-700" rel="next">
          ถัดไป →
        </a>
      ) : <span></span>}
    </div>
  )}
</DirectoryLayout>
