---
import ShopPage from '../components/ShopPage.astro';
import { getShop } from '../lib/api.js';
import { extractShopId, shopParam, shopHref } from '../lib/slug.js';

const raw = Astro.params.slug || '';
const shopId = extractShopId(raw);
let shop = await getShop(shopId);

/* ── ลิงก์เก่าที่แชร์ออกไปแล้ว ต้องยังเปิดได้ (30 ส.ค. 2569) ──
 *
 * slug ของร้านเปลี่ยนรูปแบบไปแล้ว จาก "<ชื่อ>-<shopId>" เป็น "<ชื่อ>-<shortCode>"
 * และชื่อร้านเองก็แก้ได้ตลอด · ลิงก์ที่ร้านแปะไว้ในเฟซบุ๊ก ไลน์ หรือใบปลิว
 * ตั้งแต่ก่อนเปลี่ยน จะกลายเป็น 404 ทั้งหมด ทั้งที่ร้านยังเปิดอยู่
 *
 * เจอจริงจากลิงก์ที่ร้านแชร์: /shop/ร้านอาหารลึกลับตามสั่ง-jjgame-737326
 * ร้านยังอยู่ (ตอนนี้ slug เป็น ร้านอาหารตามสั่ง-jj-game-f87d) แต่หน้าไม่ขึ้น
 *
 * ท่อนท้ายของ slug เป็นตัวระบุร้านเสมอ ไม่ว่ารูปแบบไหน — ลองอันนั้นต่อ
 * หลังบ้านหาได้ทั้งจาก _id, shopId และ slug ปัจจุบัน
 * เจอแล้วโค้ดข้างล่างจะเด้งไปที่อยู่ปัจจุบันให้เอง ลูกค้าไม่ต้องรู้อะไรเลย
 */
if (!shop) {
  const tail = String(raw).split('-').pop() || '';
  if (tail && tail !== raw && tail !== shopId) {
    shop = await getShop(tail);
  }
}

const isPublic = !!shop;

if (isPublic) {
  // Redirect bare-id or stale-slug links to the canonical pretty URL.
  //
  // 1. Skip the canonicalization entirely when ?mode= is set — QR posters
  //    point at the bare-id form, and we don't want a cached 301 round-trip
  //    to lose the query string (Cloudflare + browser both cache 301s by
  //    default; that's how the production bug presented).
  //
  // 2. When we do redirect, use 302 so CF / browser don't cache it.
  //    301s for HTML SEO get hit anyway by the regular canonical URL.
  //
  // 3. ที่อยู่มาตรฐานคือ Shop.slug ที่หลังบ้านเก็บไว้ ไม่ใช่ที่หน้านี้ปั้นเอง
  //    ลิงก์เก่าที่พา _id เต็มมา จะถูกเด้งไปที่ตัวสั้นให้เอง
  const hasMode = Astro.url.searchParams.has('mode');
  if (!hasMode && raw !== shopParam(shop)) {
    // 301 (2 พ.ย. 2569) · Bing ยังวิ่งเข้าลิงก์ _id เต็มวันละ ~80 ครั้ง (26 ต.ค. 692) เพราะ 302
    // บอกว่าย้ายชั่วคราว บอทเลยกลับมาเก็บที่อยู่เก่าซ้ำ ไม่โอนไปที่อยู่ใหม่
    // เหตุผลเดิมที่ใช้ 302 คือกลัว 301 ที่แคชไว้ทำ ?mode= หาย แต่มีด่าน hasMode ข้างบนแล้ว
    // (ลิงก์ที่มี ?mode= ไม่ถูกเด้งเลย และแคชแยกตาม query อยู่แล้ว)
    return Astro.redirect(shopHref('th', shop), 301);
  }
} else {
  Astro.response.status = 404;
}
---

<ShopPage shopId={shopId} lang="th" shop={shop} isPublic={isPublic} />
