---
import HotelPage from '../../../components/HotelPage.astro';
import { getHotel } from '../../../lib/api.js';
import { extractShopId, makeParam, hotelPath } from '../../../lib/slug.js';

const raw = Astro.params.slug || '';
const hotelId = extractShopId(raw);
const hotel = await getHotel(hotelId);
const isPublic = !!hotel;

if (isPublic) {
  const enName = hotel.nameEn || hotel.name;
  if (raw !== makeParam(enName, hotelId)) {
    return Astro.redirect(hotelPath('en', enName, hotelId), 301);
  }
} else {
  Astro.response.status = 404;
}
---

<HotelPage hotelId={hotelId} lang="en" hotel={hotel} isPublic={isPublic} />
