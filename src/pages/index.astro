---
// Wongnai-style directory homepage. Replaces the previous redirect stub.
// Surfaces hero search, top categories (shopType facets), top provinces,
// and recently active shops so there's real content for SEO even when the
// user lands without a query.
import DirectoryLayout from '../layouts/DirectoryLayout.astro';
import ShopCard from '../components/ShopCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { searchShops, getShopFacets } from '../lib/api.js';
import { typeLabel } from '../lib/shopType.js';

const [facets, featured] = await Promise.all([
  getShopFacets(),
  searchShops({ limit: 24, offset: 0 }),
]);

const title = 'ค้นหาร้านอาหาร · ร้านค้า · บริการ | TripDeDee';
// ไม่ใส่จำนวนร้าน (27 ต.ค. 2569) · ยอดจาก /shop/search กับ /shop/facets รวมหมุดที่นำเข้าจาก
// แผนที่สาธารณะ (importSource) ด้วย ตอนตรวจภูเก็ต 484 ร้าน เป็นหมุดนำเข้า 427 · ทั้งประเทศ 5,466 จาก 8,283
// หลังบ้านไม่มียอดร้านจริงแยกให้ จึงเอาตัวเลขออกแทนการเดา · AI จะได้ไม่อ้างตัวเลขที่เป่าเกินจริง
const description = `ค้นหาร้านอาหารและร้านค้าทั่วประเทศ — เมนู ราคา ที่ตั้ง รีวิว ครบในที่เดียว`;
const canonical = 'https://tripdedee.com/shop/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TripDeDee · ค้นหาร้าน',
  url: canonical,
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://tripdedee.com/shop/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const TYPE_ICON = {
  'Restaurant/Cafe': '🍽',
  Bakery: '🥐',
  'Retail Store': '🛍',
  OTOP: '🏺',
  'Beauty Salon': '💇',
  'Thai Massage': '💆',
  'Auto Repair': '🔧',
  Hardware: '🔨',
  'Service Business': '🛎',
  'Tour Operator': '🚌',
  'Tour/Transport': '🚐',
  Florist: '💐',
  Fitness: '🏋',
  Laundry: '🧺',
};
---

<DirectoryLayout
  lang="th"
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="-mx-4 mb-8 rounded-3xl bg-gradient-to-br from-orange-500 to-rose-500 px-4 py-12 text-white sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <img
        src="https://tripdedee.com/logo.png"
        alt="TripDeDee"
        class="mx-auto mb-4 h-16 w-16 rounded-2xl shadow-lg sm:h-20 sm:w-20"
        loading="eager"
      />
      <h1 class="text-3xl font-extrabold leading-tight sm:text-4xl">
        ค้นหาร้านอาหาร · ร้านค้า · บริการ<br />
        ทั่วประเทศไทย
      </h1>
      <p class="mt-3 text-base text-white/90">
        เมนู ราคา ที่ตั้ง รีวิว ครบในที่เดียว
      </p>
      <div class="mt-6">
        <SearchBar size="hero" />
      </div>
    </div>
  </section>

  {/* Categories */}
  {facets.shopTypes.length > 0 && (
    <section class="mb-10">
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-xl font-extrabold text-gray-900">ประเภทร้าน</h2>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {facets.shopTypes.slice(0, 12).map((t) => (
          <a
            href={`/shop/category/${encodeURIComponent(t.shopType)}`}
            class="group flex flex-col items-center justify-center rounded-xl border border-gray-200 bg-white p-3 text-center shadow-sm transition hover:border-orange-300 hover:shadow-md"
          >
            <span class="text-3xl">{TYPE_ICON[t.shopType] || '🏬'}</span>
            <span class="mt-1 text-sm font-bold text-gray-800 group-hover:text-orange-700">
              {typeLabel({ shopType: t.shopType }, 'th')}
            </span>
            <span class="text-[11px] text-gray-400">{t.count.toLocaleString()} ร้าน</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Provinces */}
  {facets.provinces.length > 0 && (
    <section class="mb-10">
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-xl font-extrabold text-gray-900">ค้นหาตามจังหวัด</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {facets.provinces.slice(0, 24).map((p) => (
          <a
            href={`/shop/area/${encodeURIComponent(p.province)}`}
            class="rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 transition hover:border-orange-300 hover:bg-orange-50 hover:text-orange-700"
          >
            {p.province}
            <span class="ml-1 text-xs text-gray-400">{p.count}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Featured */}
  {featured.shops.length > 0 && (
    <section class="mb-10">
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-xl font-extrabold text-gray-900">ร้านยอดนิยม</h2>
        <a href="/shop/search" class="text-sm font-medium text-orange-600 hover:underline">ดูทั้งหมด →</a>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        {featured.shops.map((shop) => <ShopCard shop={shop} lang="th" />)}
      </div>
    </section>
  )}
</DirectoryLayout>
